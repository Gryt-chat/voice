+
+// censusCount tallies RTCP packet types for the GRYT-1321 measurement. Not for merging.
+var censusMu sync.Mutex
+var census = map[string]int{}
+var censusOnce sync.Once
+
+func censusCount(dir string, pkt rtcp.Packet) {
+	name := fmt.Sprintf("%s %T", dir, pkt)
+	switch p := pkt.(type) {
+	case *rtcp.ReceiverEstimatedMaximumBitrate:
+		name = fmt.Sprintf("%s REMB", dir)
+		censusMu.Lock()
+		census[name+" last_bps"] = int(p.Bitrate)
+		censusMu.Unlock()
+	case *rtcp.TransportLayerCC:
+		name = fmt.Sprintf("%s TWCC", dir)
+	}
+	censusMu.Lock()
+	census[name]++
+	censusMu.Unlock()
+	censusOnce.Do(func() {
+		go func() {
+			for {
+				time.Sleep(5 * time.Second)
+				censusMu.Lock()
+				log.Printf("[CENSUS] %v", census)
+				censusMu.Unlock()
+			}
+		}()
+	})
+}
+
+// CensusCount is exported for the websocket package's sender-side drain.
+func CensusCount(dir string, pkt rtcp.Packet) { censusCount(dir, pkt) }
